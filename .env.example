# Visual brand theme
NEXT_PUBLIC_SITE_THEME=easy-spot

# Same-origin PHP mailer (production). Leave unset to use /api/submit.php
# NEXT_PUBLIC_SUBMIT_API_URL=https://easy-spot.com/api/submit.php

# Optional SMTP. Leave SMTP_HOST empty to use cPanel PHP mail()
# (create mailbox info@easy-spot.com in cPanel first).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=smtps
SMTP_USER=
SMTP_PASS=

MAIL_FROM=info@easy-spot.com
MAIL_FROM_NAME=Easy Spot
MAIL_TO=info@easy-spot.com
MAIL_TO_NAME=Easy Spot
